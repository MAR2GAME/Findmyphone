<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ZoneListActivity"
    android:background="@color/white">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="54dp"
        android:layout_toRightOf="@id/iv_back"
        android:text="@string/zone"
        android:textColor="@color/title_color"
        android:textSize="22sp"
        android:textStyle="bold" />
    <com.findmyphone.gpstracker.view.NativeAdWidget
        android:layout_marginTop="10dp"
        android:id="@+id/native_ad_widget"
        android:layout_below="@id/iv_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:layout_below="@id/native_ad_widget"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_zone"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="0dp">
        </androidx.recyclerview.widget.RecyclerView>
        <Button
            android:id="@+id/bt_add"
            android:layout_width="330dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_selector"
            android:text="@string/add_new_zone"
            android:textAllCaps="false"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_seletor"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="60dp"
            app:layout_constraintTop_toBottomOf="@id/rl_name"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
</RelativeLayout>