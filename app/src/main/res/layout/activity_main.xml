<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.MainActivity"
    android:fillViewport="true"
    android:paddingBottom="30dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginTop="60dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:text="@string/app_name"
                android:gravity="center_vertical"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="32dp">
            </TextView>
            <ImageView
                android:id="@+id/iv_setting"
                android:src="@mipmap/ic_setting"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_width="32dp"
                android:layout_height="32dp">
            </ImageView>
            <ImageView
                android:id="@+id/iv_live_location"
                android:layout_marginTop="15dp"
                android:background="@mipmap/action_1_bg"
                app:layout_constraintTop_toBottomOf="@id/iv_setting"
                android:layout_width="match_parent"
                android:layout_height="100dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_location_display"
                android:text="@string/live_location_display"
               app:layout_constraintLeft_toLeftOf="@id/iv_live_location"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/iv_live_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:text="@string/live_location_display_hint"
                app:layout_constraintLeft_toLeftOf="@id/iv_live_location"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginLeft="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_location_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

            <ImageView
                android:id="@+id/iv_tracker"
                android:background="@mipmap/action_2_bg"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/iv_live_location"
                android:layout_width="match_parent"
                android:layout_height="100dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_real_time_tracker"
                android:text="@string/real_time_tracker"
                app:layout_constraintLeft_toLeftOf="@id/iv_live_location"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/iv_tracker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <TextView
                android:text="@string/real_time_tracker_hint"
                app:layout_constraintLeft_toLeftOf="@id/tv_real_time_tracker"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tv_real_time_tracker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_action"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="15dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>