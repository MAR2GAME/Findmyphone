<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cl_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/tv_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/map_type_nor"
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:layout_marginTop="10dp">
    </TextView>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_map"
        android:src="@mipmap/ic_friend_location"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@id/tv_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_margin="1dp"
        app:shapeAppearanceOverlay="@style/OnlyTopCornersRounded"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="270dp">
    </com.google.android.material.imageview.ShapeableImageView>
    <TextView
        android:id="@+id/tv_name"
        android:layout_marginTop="10dp"
        android:textSize="15sp"
        android:textColor="@color/title_color"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/iv_map"
        app:layout_constraintLeft_toLeftOf="@id/iv_map"
        android:layout_marginLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>

    <ImageView
        android:id="@+id/iv_hint"
        android:src="@mipmap/ic_item_hint"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/iv_map"
        app:layout_constraintRight_toRightOf="@id/iv_map"
        android:layout_width="20dp"
        android:layout_height="20dp">
    </ImageView>
    <TextView
        android:id="@+id/tv_time"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/iv_map"
        app:layout_constraintRight_toLeftOf="@id/iv_hint"
        android:layout_marginRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>