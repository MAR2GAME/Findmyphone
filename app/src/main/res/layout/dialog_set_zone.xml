<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_shape">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/set_up_zone"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:visibility="gone"
        android:layout_alignParentRight="true"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:src="@mipmap/iv_delete"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@id/tv_title"
        android:layout_margin="20dp"
        android:background="@drawable/map_type_nor"/>
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_title"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="40dp"
        android:text="@string/zone_name"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        android:textStyle="bold"/>


    <LinearLayout
        android:id="@+id/rl_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/tv_hint"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="38dp"
        android:background="@drawable/code_shape"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/enter_zone_name"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/title_color"
            android:textColorHint="#999999"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_bg"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@id/rl_name"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="29dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/map_type_nor" />

    <TextView
        android:id="@+id/tv_hint1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_name"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="50dp"
        android:text="@string/alert_triggers"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/ll_enter_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_hint1"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_enter_check"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_zone_check"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:text="@string/on_enter"
            android:textColor="@color/title_color"
            android:textSize="17sp"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_leave_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_hint1"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@id/ll_enter_check"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_leave_check"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_zone_check"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:text="@string/on_leave"
            android:textColor="@color/title_color"
            android:textSize="17sp" />
    </LinearLayout>

    <Button
        android:id="@+id/bt_next"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_below="@id/tv_bg"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_selector"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="20sp"
        android:textStyle="bold" />


</RelativeLayout>