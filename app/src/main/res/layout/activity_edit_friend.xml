<!--            android:layout_height="90dp">-->
<!--        </ImageView>-->
<!--    </RelativeLayout>-->
    <TextView
        android:id="@+id/tv_other"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/other_shape"
        android:text="@string/other"
        android:layout_below="@id/rl_female"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:layout_marginTop="15dp"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/bt_save"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/btn_selector"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:layout_marginTop="15dp"
        android:layout_below="@id/tv_other"
        android:layout_centerHorizontal="true"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <com.findmyphone.gpstracker.view.NativeAdWidget
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:id="@+id/native_ad_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</RelativeLayout>