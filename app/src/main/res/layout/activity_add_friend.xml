<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.AddFriendActivity">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="54dp"
        android:layout_toRightOf="@id/iv_back"
        android:text="@string/add_Friend"
        android:textColor="@color/title_color"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_hint"
        android:textSize="20sp"
        android:textColor="@color/title_color"
        android:text="@string/enter_secure_code"
        android:layout_marginTop="30dp"
        android:layout_below="@id/iv_back"
        android:layout_marginLeft="20dp"
        android:layout_width="330dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content">
    </TextView>
    <LinearLayout
        android:id="@+id/rl_code"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_marginTop="25dp"
        android:orientation="horizontal"
        android:layout_centerHorizontal="true"
        android:background="@drawable/code_shape"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_below="@id/tv_hint"
        >
        <ImageView
            android:src="@mipmap/ic_lock"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="15dp"
            android:layout_width="30dp"
            android:layout_height="30dp">
        </ImageView>

        <EditText
            android:id="@+id/et_code"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="10dp"
            android:background="@null"
            android:maxLines="1"
            android:hint="@string/enter_secure_code"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:inputType="text"
            android:textColor="@color/title_color"
            android:textColorHint="#999999"
            android:textSize="18sp"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="10dp"
            android:src="@mipmap/ic_close"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_search"
        android:background="@drawable/btn_selector"
        android:layout_marginTop="20dp"
        android:layout_below="@id/rl_code"
        android:layout_centerHorizontal="true"
        android:layout_width="330dp"
        android:layout_height="55dp">
    </TextView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/rl_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:src="@mipmap/ic_serarch"
            android:layout_width="30dp"
            android:layout_height="30dp">
        </ImageView>
        <TextView
            android:textSize="20sp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:text="@string/search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>

    <Button
        android:id="@+id/bt_next"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/btn_selector"
        android:text="@string/next"
        android:textAllCaps="false"
        android:layout_centerHorizontal="true"
        android:textColor="@color/text_seletor"
        android:layout_below="@id/tv_search"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <com.findmyphone.gpstracker.view.NativeAdWidget
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:id="@+id/native_ad_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</RelativeLayout>