<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.DeleteFriendActivity">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>

    <ImageView
        android:id="@+id/iv_gender"
        android:layout_below="@id/iv_back"
        android:layout_marginTop="30dp"
        android:src="@mipmap/ic_male_check"
        android:layout_centerHorizontal="true"
        android:layout_width="100dp"
        android:layout_height="100dp">
    </ImageView>

    <TextView
        android:id="@+id/tv_name"
        android:layout_below="@id/iv_gender"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:textColor="@color/title_color"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>


    <LinearLayout
        android:id="@+id/ll_edit"
        android:layout_below="@id/tv_name"
        android:background="@drawable/map_type_nor"
        android:layout_centerHorizontal="true"
        android:paddingLeft="10dp"
        android:orientation="horizontal"
        android:paddingRight="10dp"
        android:layout_marginTop="25dp"
        android:layout_width="330dp"
        android:layout_height="55dp">
        <ImageView
            android:src="@mipmap/ic_pop"
            android:layout_gravity="center_vertical"
            android:layout_width="35dp"
            android:layout_height="35dp">
        </ImageView>
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/edit_name_and_gender"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_track"
        android:layout_below="@id/ll_edit"
        android:background="@drawable/map_type_nor"
        android:layout_centerHorizontal="true"
        android:paddingLeft="10dp"
        android:orientation="horizontal"
        android:paddingRight="10dp"
        android:layout_marginTop="15dp"
        android:layout_width="330dp"
        android:layout_height="55dp">
        <ImageView
            android:src="@mipmap/ic_map"
            android:layout_gravity="center_vertical"
            android:layout_width="35dp"
            android:layout_height="35dp">
        </ImageView>
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/track_this_user"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
        </TextView>

        <ImageView
            android:id="@+id/iv_check"
            android:src="@mipmap/iv_check"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:layout_width="50dp"
            android:layout_height="40dp">
        </ImageView>
    </LinearLayout>
    <Button
        android:id="@+id/bt_delete"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_below="@id/ll_track"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:background="@drawable/btn_del_selector"
        android:text="@string/delete_friend"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="18sp"/>


</RelativeLayout>