<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:background="@drawable/dialog_shape"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="@string/sos_alert"
        android:textColor="#FF325B"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_title"
        android:text="@string/sending_sos_hint"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="16sp"/>
    <Button
        android:id="@+id/bt_confirm"
        android:layout_width="270dp"
        android:layout_height="55dp"
        android:layout_below="@id/tv_hint"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:background="@drawable/btn_del_selector"
        android:text="@string/confirm"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="18sp"/>
    <TextView
        android:id="@+id/tv_cancel"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/cancel"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="#A61A1A1A"
        android:layout_below="@id/bt_confirm"
        android:layout_width="100dp"
        android:layout_height="55dp">
    </TextView>
</RelativeLayout>