<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF325B"
    tools:context=".ui.SosActivity">
    <TextView
        android:id="@+id/tv_title"
        android:text="@string/sos_alert"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="320dp"
        android:layout_below="@id/tv_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="@string/sos_alert_hint"
        android:gravity="center_horizontal"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/tv_time"
        android:background="@drawable/sos_time_shape"
        android:text="10"
        android:gravity="center"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FF325B"
        android:layout_centerInParent="true"
        android:layout_width="170dp"
        android:layout_height="170dp">
    </TextView>
    <Button
        android:id="@+id/bt_cancel"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/btn_press"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="#FE5653"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp"
        android:layout_marginTop="30dp"
        android:textSize="20sp"
        android:textStyle="bold"/>
</RelativeLayout>