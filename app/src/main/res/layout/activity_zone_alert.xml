<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.ZoneAlertActivity">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="54dp"
        android:layout_toRightOf="@id/iv_back"
        android:text="@string/zone_alert"
        android:textColor="@color/title_color"
        android:textSize="22sp"
        android:textStyle="bold" />
    <com.findmyphone.gpstracker.view.NativeAdWidget
        android:id="@+id/native_ad_widget"
        android:layout_below="@id/iv_back"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:id="@+id/ll_time"
        android:layout_below="@id/native_ad_widget"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <RelativeLayout
            android:id="@+id/rl_start_time"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_marginRight="10dp"
            android:layout_height="match_parent">
            <TextView
                android:text="@string/start_time"
                android:gravity="center_vertical"
                android:textColor="@color/title_color"
                android:textSize="16sp"
                android:layout_marginLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="50dp">
            </TextView>
            <TextView
                android:id="@+id/tv_start_time"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:paddingLeft="10dp"
                android:textColor="@color/title_color"
                android:textStyle="bold"
                android:background="@drawable/map_type_nor"
                android:layout_marginTop="50dp"
                android:layout_width="match_parent"
                android:layout_height="60dp">
            </TextView>
            

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_end_time"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView
                android:text="@string/end_time"
                android:gravity="center_vertical"
                android:textColor="@color/title_color"
                android:textSize="16sp"
                android:layout_marginLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="50dp">
            </TextView>
            <TextView
                android:id="@+id/tv_end_time"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:textColor="@color/title_color"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:background="@drawable/map_type_nor"
                android:layout_marginTop="50dp"
                android:layout_width="match_parent"
                android:layout_height="60dp">
            </TextView>
        </RelativeLayout>
    </LinearLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/sm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_time"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        >
        <com.scwang.smart.refresh.header.ClassicsHeader
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:srlTextPulling="@string/pull_down"
            app:srlTextRelease="@string/release_to"
            app:srlTextFinish="@string/refresh_successfully"
            app:srlTextRefreshing="@string/refreshing"
            app:srlEnableLastTime="false"
            app:srlAccentColor="@color/title_color"
            app:srlTextSizeTime="18sp"
            app:srlTextSizeTitle="18sp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_alert"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </androidx.recyclerview.widget.RecyclerView>
        <com.scwang.smart.refresh.footer.ClassicsFooter
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:srlTextFailed="@string/loading_failed"
            app:srlTextFinish="@string/loaded_successfully"
            app:srlTextLoading="@string/load_more"
            app:srlTextNothing="@string/no_data"
            app:srlAccentColor="@color/title_color"
            app:srlTextSizeTime="18sp"
            app:srlTextSizeTitle="18sp" />
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <ImageView
        android:id="@+id/iv_noData"
        android:textColor="@color/title_color"
        android:textSize="16sp"
        android:visibility="gone"
        android:src="@mipmap/ic_location_erro"
        android:gravity="center_horizontal"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/ll_time"
        android:layout_marginTop="80dp"
        android:layout_width="260dp"
        android:layout_height="260dp">
    </ImageView>
</RelativeLayout>