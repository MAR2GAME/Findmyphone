<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ZoneDetailsActivity">
    <fragment
        android:id="@+id/info_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="265dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        />

    <ImageView
        android:id="@+id/iv_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="55dp"
        android:layout_marginLeft="15dp"
        android:src="@mipmap/ic_back"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/iv_back"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="10dp"
        android:orientation="horizontal"
        android:background="@drawable/btn_press"
        android:layout_width="300dp"
        android:layout_height="50dp">

        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@null"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:inputType="text"
            android:layout_marginLeft="15dp"
            android:hint="@string/enter_location"
            android:textColor="@color/title_color"
            android:textColorHint="#999999"
            android:textSize="15sp"/>

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="5dp"
            android:src="@mipmap/ic_close"
            android:visibility="gone"
            />
        <TextView
            android:background="#261a1a1a"
            android:layout_gravity="center_vertical"
            android:layout_width="1dp"
            android:layout_height="30dp">
        </TextView>
        <TextView
            android:id="@+id/tv_search"
            android:layout_marginLeft="5dp"
            android:text="@string/search"
            android:layout_marginRight="15dp"
            android:textSize="16sp"
            android:textColor="@color/title_color"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/bottom_shape"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="275dp">

        <RelativeLayout
            android:background="@drawable/map_type_nor"
            android:layout_width="match_parent"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_height="120dp">
            <TextView
                android:text="@string/radius"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:textSize="18sp"
                android:textColor="@color/title_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <ImageView
                android:id="@+id/iv_hint"
                android:layout_marginRight="15dp"
                android:layout_marginTop="8dp"
                android:src="@mipmap/ic_hint"
                android:layout_alignParentRight="true"
                android:layout_width="30dp"
                android:layout_height="30dp">
            </ImageView>

            <LinearLayout
                android:layout_below="@id/iv_hint"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="40M"
                    android:textSize="15sp"
                    android:textColor="@color/theme_color"
                     android:layout_marginTop="35dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <com.findmyphone.gpstracker.view.RectSliderView
                    android:id="@+id/slider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:minValue="40"
                    app:maxValue="500"
                    app:progress="0.3"
                    app:textColor="@color/theme_color"
                    app:textSize="14sp" />
                <TextView
                    android:text="500M"
                    android:textSize="15sp"
                    android:textColor="@color/theme_color"
                    android:layout_marginTop="35dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:id="@+id/bt_next"
            android:layout_width="320dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/btn_selector"
            android:text="@string/next"
            android:layout_marginTop="30dp"
            android:textAllCaps="false"
            android:textColor="@color/text_seletor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rl_name"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>