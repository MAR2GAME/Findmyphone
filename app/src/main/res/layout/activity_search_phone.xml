<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.SearchPhoneActivity">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="54dp"
        android:layout_toRightOf="@id/iv_back"
        android:text="@string/phone_number_location"
        android:textColor="@color/title_color"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_back"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="@string/enter_phone_number"
        android:textColor="@color/title_color"
        android:textSize="18sp"/>

    <com.hbb20.CountryCodePicker
        android:id="@+id/ccp"
        android:background="@drawable/map_type_check"
        android:layout_below="@id/tv_hint"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_width="90dp"
        android:layout_height="55dp"
        android:gravity="center"
        app:ccp_defaultNameCode="US"
        app:ccp_showFlag="false"
        app:ccp_showNameCode="false"
        app:ccp_showPhoneCode="true" />
    <RelativeLayout
        android:id="@+id/rl_phone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/tv_hint"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_toRightOf="@id/ccp"
        android:background="@drawable/edit_shape">
        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="55dp"
            android:background="@null"
            android:hint="@string/enter_mobile"
            android:inputType="number"
            android:maxLines="1"
            android:textColor="@color/title_color"
            android:textColorHint="#999999"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:src="@mipmap/ic_close" />
    </RelativeLayout>


    <Button
        android:id="@+id/bt_search"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/ccp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/btn_selector"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/bt_search"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/language_normal_shape"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/tv_hint1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/phone_number_location_notice"
            android:textColor="@color/title_color"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tv_hint2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="@string/phone_number_location_example"
            android:textColor="@color/title_color"
            android:textSize="16sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="@string/phone_number_location_hint"
            android:textColor="@color/hint_color"
            android:textSize="16sp"/>
    </LinearLayout>
    <com.findmyphone.gpstracker.view.NativeAdWidget
        android:id="@+id/native_ad_widget"
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:layout_height="wrap_content" />
</RelativeLayout>