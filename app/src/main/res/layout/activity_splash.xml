<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.SplashActivity"
    android:background="@color/white"
    >

    <TextView
        android:id="@+id/sp_hit1"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/title_color"
        android:text="@string/welcome_to_locShare"
        android:layout_marginTop="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/sp_hit2"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/sp_hit1"
        android:textColor="@color/title_color"
        android:text="@string/sp_hint"
        android:gravity="center_horizontal"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="match_parent"
        android:paddingRight="25dp"
        android:paddingLeft="25dp"
        android:layout_height="wrap_content">
    </TextView>
    <ImageView
        android:src="@mipmap/splash_bg"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@id/sp_hit2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:scaleType="fitXY"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </ImageView>

    <ImageView
        android:src="@mipmap/ic_logo"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/sp_hit2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="126dp"
        android:layout_height="126dp">
    </ImageView>

    <RelativeLayout
        android:id="@+id/rl_progress"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="160dp">
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="280dp"
            android:layout_height="6dp"
            android:layout_centerVertical="true"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_layer" />
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/progressBar"
            android:gravity="center_vertical"
            android:text="0%"
            android:textColor="@color/title_color"
            android:textSize="16sp" />
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_hint"
        android:textSize="16sp"
        android:textColor="@color/hint_color"
        android:text="@string/please_wait_a_moment"
        app:layout_constraintTop_toBottomOf="@id/rl_progress"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>

    <TextView
        android:id="@+id/tv_privacy"
        android:textSize="14sp"
        android:textColor="@color/title_color"
        android:text="@string/privacy_policies"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="30dp"
        android:layout_marginBottom="70dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/tv_terms"
        android:textSize="14sp"
        android:textColor="@color/title_color"
        android:text="@string/terms_of_use"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="70dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
</androidx.constraintlayout.widget.ConstraintLayout>