<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Google 地图 Fragment -->






    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:layout_marginBottom="105dp"/>

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:src="@mipmap/ic_back"/>
    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="50dp"
        android:layout_height="150dp"
        android:layout_marginTop="55dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/btn_press"
        android:orientation="vertical"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_type"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:src="@mipmap/ic_map_type">
            </ImageView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_train"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:src="@mipmap/ic_train">
            </ImageView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_postion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:src="@mipmap/ic_postion">
            </ImageView>
        </RelativeLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_move"
        android:background="@drawable/dialog_shape"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="50dp"
        android:layout_height="50dp">
        <ImageView
            android:src="@mipmap/ic_move"
            android:layout_centerInParent="true"
            android:layout_width="25dp"
            android:layout_height="25dp">
        </ImageView>
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_sos"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/sos_shape"
        android:text="sos"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ll_content"
        android:layout_width="50dp"
        android:layout_height="50dp">
    </TextView>
    <LinearLayout
        android:paddingTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/dialog_shape"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_height="120dp">
        <ImageView
            android:id="@+id/ic_add"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:src="@mipmap/ic_add"
            android:layout_height="60dp">
        </ImageView>
        <ImageView
            android:id="@+id/ic_friend"
            android:src="@mipmap/ic_friend"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="60dp">
        </ImageView>
        <ImageView
            android:id="@+id/ic_alert"
            android:src="@mipmap/ic_alert"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="60dp">

        </ImageView>
        <ImageView
            android:id="@+id/ic_set_zone"
            android:src="@mipmap/ic_set_zone"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="60dp">

        </ImageView>
        <ImageView
            android:id="@+id/iv_track"
            android:src="@mipmap/iv_track"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="60dp">
        </ImageView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>